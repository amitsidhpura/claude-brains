<idea-plugin>
    <id>io.github.amitsidhpura.claude-brains</id>
    <name>Claude Brains</name>
    <vendor url="https://github.com/amitsidhpura/claude-brains">Amit Sidhpura</vendor>

    <description><![CDATA[
        Claude Code for JetBrains IDEs (unofficial). Runs Anthropic's official
        <code>claude</code> CLI inside PhpStorm and other IntelliJ IDEs, wired to the editor
        through the same IDE-MCP bridge the VS Code extension uses. Opens in a right-side tool
        window. Requires the <code>claude</code> CLI installed and logged in — does not bundle
        or redistribute Anthropic code. Not affiliated with Anthropic or JetBrains.
    ]]></description>

    <!-- Platform only: works in PhpStorm and any other IntelliJ IDE. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The sidebar: anchor="right" == VS Code's right sidebar. -->
        <toolWindow id="Claude Brains"
                    anchor="right"
                    secondary="false"
                    icon="/icons/claude.svg"
                    factoryClass="io.github.amitsidhpura.claudebrains.ui.ClaudeToolWindowFactory"/>

        <projectService serviceImplementation="io.github.amitsidhpura.claudebrains.ClaudeSessionService"/>

        <!-- Balloon used by DiffReview for Accept/Reject on proposed changes. -->
        <notificationGroup id="Claude Brains" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
