<idea-plugin>
    <id>com.syncroze.claude-code</id>
    <name>Claude Code (Syncroze)</name>
    <vendor email="support@syncroze.com">Syncroze</vendor>

    <description><![CDATA[
        Runs Anthropic's official <code>claude</code> CLI inside PhpStorm, wired to the editor
        through the same IDE-MCP bridge the VS Code extension uses. Opens in a right-side tool
        window. Personal/interop build — does not bundle or redistribute Anthropic code.
    ]]></description>

    <!-- Platform only: works in PhpStorm and any other IntelliJ IDE. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The sidebar: anchor="right" == VS Code's right sidebar. -->
        <toolWindow id="Claude Code"
                    anchor="right"
                    secondary="false"
                    icon="/icons/claude.svg"
                    factoryClass="com.syncroze.claudecode.ui.ClaudeToolWindowFactory"/>

        <projectService serviceImplementation="com.syncroze.claudecode.ClaudeSessionService"/>

        <!-- Balloon used by DiffReview for Accept/Reject on proposed changes. -->
        <notificationGroup id="Claude Code" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
