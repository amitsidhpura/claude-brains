# Anthropic's extracted VS Code extension — proprietary, personal reference only. NEVER commit.
/vscode/

# Build & IDE artifacts
.idea/
*.iml
plugin/.gradle/
plugin/.kotlin/
plugin/build/
plugin/.intellijPlatform/
# NB: gradle/wrapper/gradle-wrapper.jar is deliberately NOT ignored — the wrapper
# only bootstraps if the jar is committed, so a fresh clone can run ./gradlew.

# Third-party reference clones (not ours)
/reference/

# Playwright MCP browser-session artifacts (snapshots/console logs from design checks)
/.playwright-mcp/

# Claude Code local settings (per-machine permission grants)
.claude/

# Personal scratch space — notes, throwaway files. Never part of the plugin.
/_local/

# Python bytecode from tools/ (live_harness imports cdp)
__pycache__/
